diff --git a/Vinyl/Vinyl/AppleMusicStore.swift b/Vinyl/Vinyl/AppleMusicStore.swift
index 9bc8ac6..c4b64ec 100644
--- a/Vinyl/Vinyl/AppleMusicStore.swift
+++ b/Vinyl/Vinyl/AppleMusicStore.swift
@@ -549,0 +550,13 @@
+    /// The profiling timer supplies a fixed queue snapshot at the real player's 4 Hz cadence.
+    func profilePlayback(time: TimeInterval) {
+        guard TracklistProfile.enabled, let song = TracklistProfile.songs.first else { return }
+        currentTitle = song.title
+        currentArtist = song.artistName
+        currentArtwork = nil
+        currentSongID = song.id
+        currentCatalogID = song.id
+        duration = song.duration ?? 0
+        position = time
+        isPlaying = true
+    }
